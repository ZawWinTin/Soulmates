#!/usr/bin/env bash
# Soulmates pre-commit style gate (checkpoint 7). Enable once per clone:
#   git config core.hooksPath .githooks
# Bypass for an emergency commit with: git commit --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# 1) whitespace errors in staged code and text (not Unity YAML: scenes and prefabs keep trailing spaces)
if ! git diff --cached --check -- '*.cs' '*.md' '*.json' '*.sh' '*.yml' '*.yaml'; then
    echo "pre-commit: whitespace errors above - fix them and re-stage." >&2
    exit 1
fi

# 2) CSharpier (.config/dotnet-tools.json, .csharpierignore) on the staged C# files
files=()
while IFS= read -r f; do
    case "$f" in *.cs) files+=("$f") ;; esac
done < <(git diff --cached --name-only --diff-filter=ACMR)
[ ${#files[@]} -eq 0 ] && exit 0
if ! command -v dotnet >/dev/null; then
    echo "pre-commit: dotnet not found - C# style NOT checked. Install: brew install --cask dotnet-sdk" >&2
    exit 0
fi
if ! dotnet csharpier check "${files[@]}" >/dev/null 2>&1; then
    echo "pre-commit: run  dotnet csharpier format ${files[*]}  and re-stage." >&2
    exit 1
fi
